{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Antigravity Local Agents",
  "description": "Manage local OpenAI-compatible models, auto harness routing, and live subagent monitor.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Antigravity Local Agents",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Local Agents"
      },
      {
        "path": "/monitor.html",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Local Subagents"
      }
    ]
  }
}
